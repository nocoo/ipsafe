{
  "name": "ipsafe",
  "version": "1.0.6",
  "description": "A CLI tool that validates network connectivity before executing commands",
  "main": "index.js",
  "bin": {
    "ipsafe": "bin/ipsafe.js"
  },
  "scripts": {
    "test": "node scripts/ensure-patches.js && vitest run",
    "test:coverage": "node scripts/ensure-patches.js && vitest run --coverage",
    "lint": "node scripts/ensure-patches.js && eslint --max-warnings=0 bin/ lib/ __tests__/",
    "lint:fix": "node scripts/ensure-patches.js && eslint --max-warnings=0 bin/ lib/ __tests__/ --fix",
    "verify": "npm run lint && npm run test:coverage",
    "verify:packed-install": "node scripts/verify-packed-cli-install.js",
    "prepublishOnly": "npm run verify && npm run verify:packed-install",
    "prepare": "node scripts/prepare-husky.js"
  },
  "keywords": [
    "cli",
    "network",
    "connectivity",
    "safe",
    "command"
  ],
  "author": "nocoo",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "patch-package": "8.0.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "@eslint/config-array": "0.23.5",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "vite": "8.1.6"
  }
}
